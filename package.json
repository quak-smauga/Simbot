{
  "name": "qwe",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "pnpm --filter @qwe/cli dev -- dev",
    "mock": "pnpm --filter @qwe/cli dev -- dev --mock",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "qwe": "pnpm --filter @qwe/cli dev --",
    "docs": "pnpm --filter @qwe/docs dev",
    "docs:build": "pnpm --filter @qwe/docs docs:build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
