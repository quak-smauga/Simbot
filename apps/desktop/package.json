{
  "name": "@qwe/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "qwe desktop — skorupa Electrona nad chat serverem: okno główne, widget nad wszystkim, tray, skróty globalne",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "mock": "electron . --mock",
    "icons": "node scripts/make-icons.js",
