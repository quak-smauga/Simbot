{
  "name": "@qwe/mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "qwe: klient Model Context Protocol (stdio + Streamable HTTP, zero zależności) i menedżer wielu serwerów — narzędzia MCP jako tagi nativeapi",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions=development src/selftest.ts"
  },
  "dependencies": {
    "@qwe/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
