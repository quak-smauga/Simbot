# ── LLM (Anthropic) ──
ANTHROPIC_API_KEY=sk-ant-...
# model rozmowy (chat) i model wykonawczy (computer executor — tańszy, szybszy)
QWE_CHAT_MODEL=claude-sonnet-5-5
QWE_EXECUTOR_MODEL=claude-haiku-5-5
QWE_CHAT_MAX_TOKENS=1200
# 1 = model myśli przed odpowiedzią (wolniejszy start, limit dostaje +4000 na myślenie); domyślnie 0
QWE_CHAT_THINKING=0
# osobne modele dla computera (puste = QWE_EXECUTOR_MODEL)
QWE_PLANNER_MODEL=
QWE_EXECUTOR_DESKTOP_MODEL=

# ── głos (ElevenLabs) — bez kluczy chat działa tekstowo, voice tylko w --mock ──
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=WtA85syCrJwasGeHGH2p
ELEVEN_TTS_MODEL=eleven_flash_v2_5
ELEVEN_STT_MODEL=scribe_v1

# ── web.query ──
SEARCH_PROVIDER=auto          # auto = tavily → brave → duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_FETCH_PAGES=3
SEARCH_PAGE_CHARS=3500
SEARCH_TIMEOUT_MS=8000

# ── computer ──
QWE_COMPUTER_HEADLESS=0       # 1 = bez okna (docker); 0 = widoczna przeglądarka (logowanie przez usera)
QWE_COMPUTER_CHANNEL=         # puste = Chromium Playwrighta (pnpm --filter @qwe/plugin-computer exec playwright install chromium); chrome | msedge = zainstalowana przeglądarka
QWE_COMPUTER_VISION=1         # 1 = executor dostaje też screenshot (vision), 0 = tylko DOM
QWE_COMPUTER_MAX_STEPS=25
QWE_COMPUTER_DESKTOP_MAX_STEPS=30
QWE_COMPUTER_PLANNER=1        # 0 = bez plannera (sama pętla decydenta)

# ── serwery ──
QWE_CHAT_PORT=3100
QWE_AGENT_PORT=7777
QWE_HOST=127.0.0.1
# agent: "spawn" = chat sam podnosi proces agenta po pierwszej akcji (dev), "url" = już działa (np. docker)
QWE_AGENT_MODE=spawn
QWE_AGENT_URL=http://127.0.0.1:7777
# simy: jeden folder = jeden sim (AgentManifest.yaml + persona + plugins/ + skills/); przykład: examples/kucharz
QWE_AGENTS_DIR=./agents
QWE_DEFAULT_AGENT=sima
# sim dla `qwe inspect` / `qwe build` bez argumentu
QWE_AGENT_DIR=./agents/sima
# dane (sqlite, eventy, screenshoty, profil przeglądarki)
QWE_DATA_DIR=./data

# ── kontekst i pamięć ──
QWE_CTX_TRIGGER_CHARS=40000   # od ilu znaków niestreszczonej rozmowy zaczyna się streszczanie
QWE_CTX_KEEP=12               # ile ostatnich wiadomości zostaje dosłownie
QWE_RECAP_IDLE_MS=90000       # cisza przed recapem rozmowy

# ── desktop (Electron) ──
QWE_SHORTCUT_WIDGET=Alt+Space
QWE_SHORTCUT_STOP=Control+Alt+Escape
